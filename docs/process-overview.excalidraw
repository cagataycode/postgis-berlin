", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1351984260, "version": 1, "versionNonce": 77989029, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "2nkg60t29v6swbuo1sj7", "type": "text", "x": 2122.4075621013076, "y": 4827.75, "width": 66.24000000000001, "height": 20.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1780427158, "version": 1, "versionNonce": 1885097012, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "79.2 ms", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "79.2 ms", "autoResize": false, "lineHeight": 1.25}, {"id": "208hv9v23sqdwgoy5yag", "type": "rectangle", "x": 1834, "y": 4851.75, "width": 219.34274099607887, "height": 20, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 505287243, "version": 1, "versionNonce": 965314980, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "ep0ttimhlsfxkhox63u1", "type": "text", "x": 2063.3427409960786, "y": 4851.75, "width": 66.24000000000001, "height": 20.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1346664571, "version": 1, "versionNonce": 223481041, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "16.6 ms", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "16.6 ms", "autoResize": false, "lineHeight": 1.25}, {"id": "327zhrjpgyr4wgbs8gn8", "type": "text", "x": 1834, "y": 4891.75, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 959167914, "version": 1, "versionNonce": 2096008003, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Orange = before, green = after (log scale, warm runs of EXPLAIN ANALYZE)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Orange = before, green = after (log scale, warm runs of EXPLAIN ANALYZE)", "autoResize": false, "lineHeight": 1.25}, {"id": "d8dxzt4zds056oghdi56", "type": "text", "x": 1834, "y": 4923.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1663857073, "version": 1, "versionNonce": 804755132, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• 5 automatic tests assert the query plans (one partition only, index used)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 5 automatic tests assert the query plans (one partition only, index used)", "autoResize": false, "lineHeight": 1.25}, {"id": "tl8agsswzoqxsdh866fm", "type": "text", "x": 1834, "y": 4955.25, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1817307599, "version": 1, "versionNonce": 89633714, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Rejected with numbers: composite GiST (kind_code, geom) is 2x larger and not\n  faster", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Rejected with numbers: composite GiST (kind_code, geom) is 2x larger and not\n  faster", "autoResize": false, "lineHeight": 1.25}, {"id": "j5hyfulhq8jmm9bfcm5k", "type": "text", "x": 1834, "y": 5010.75, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 520581359, "version": 1, "versionNonce": 1127748837, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Cost we accept: the JSON (GIN) index makes bulk load 1.7x slower and takes\n  138 MB", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Cost we accept: the JSON (GIN) index makes bulk load 1.7x slower and takes\n  138 MB", "autoResize": false, "lineHeight": 1.25}, {"id": "ewearws15bevblac937n", "type": "text", "x": 1834, "y": 5082.25, "width": 143.20000000000002, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17432441, "version": 1, "versionNonce": 1976977067, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Where to look", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where to look", "autoResize": false, "lineHeight": 1.25}, {"id": "chizl92nqluqs2z49bq9", "type": "text", "x": 1834, "y": 5115.25, "width": 456.96, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 644375459, "version": 1, "versionNonce": 1523052068, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "docs/schema-v2/indexing-and-explain.md\ndocs/schema-v2/explain/01 ... 07  (full plans)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "docs/schema-v2/indexing-and-explain.md\ndocs/schema-v2/explain/01 ... 07  (full plans)", "autoResize": false, "lineHeight": 1.25}, {"id": "pvf11wv526jpnp2fi3sg", "type": "rectangle", "x": 0, "y": 5215.25, "width": 800, "height": 362, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 236121865, "version": 1, "versionNonce": 1405292518, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "thbbvkf5br3i2hay4igq", "type": "rectangle", "x": 890, "y": 5215.25, "width": 1750, "height": 362, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 648384523, "version": 1, "versionNonce": 727120914, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "x6jwlst1ualmxd9fiy3e", "type": "arrow", "x": 808, "y": 5396.25, "width": 74, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 186375061, "version": 1, "versionNonce": 1168681464, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [74, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "uwcay7d333ft1wpjs8zd", "type": "text", "x": 808, "y": 5364.25, "width": 74, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1638294361, "version": 1, "versionNonce": 331310941, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "proof", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "proof", "autoResize": false, "lineHeight": 1.25}, {"id": "3pcdl4fdsl4my0cb4l09", "type": "rectangle", "x": 24, "y": 5239.25, "width": 46, "height": 46, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#1971c2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 532936296, "version": 1, "versionNonce": 1042556593, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "hr7u7nlyphi5kplknqnu", "type": "text", "x": 24, "y": 5246.25, "width": 46, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1115845948, "version": 1, "versionNonce": 925555240, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "7", "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "7", "autoResize": false, "lineHeight": 1.25}, {"id": "gh8wcqhu9x0lgzm78v0j", "type": "text", "x": 86, "y": 5245.25, "width": 357.44, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 324344572, "version": 1, "versionNonce": 1972805694, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A mistake can be rewound", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A mistake can be rewound", "autoResize": false, "lineHeight": 1.25}, {"id": "777vsf6928lqqis5k07d", "type": "text", "x": 24, "y": 5299.25, "width": 752, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1626317044, "version": 1, "versionNonce": 1600258595, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The database continuously copies its change log to a backup folder.\nWith one full backup plus that log we can rebuild the database as it\nwas at any second. We practised it: delete every public toilet, then\nbring them back in a spare copy without risking the live database.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The database continuously copies its change log to a backup folder.\nWith one full backup plus that log we can rebuild the database as it\nwas at any second. We practised it: delete every public toilet, then\nbring them back in a spare copy without risking the live database.", "autoResize": false, "lineHeight": 1.25}, {"id": "5hmpechiz306ke7a1nf4", "type": "text", "x": 910, "y": 5235.25, "width": 630.1999999999999, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 58278461, "version": 1, "versionNonce": 1804992235, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Archive settings and the recovery drill (docs/operations.md)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Archive settings and the recovery drill (docs/operations.md)", "autoResize": false, "lineHeight": 1.25}, {"id": "ds13z40582f7uhbljqrh", "type": "rectangle", "x": 910, "y": 5265.25, "width": 900, "height": 292, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 431359993, "version": 1, "versionNonce": 1823324985, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "9590xmx9zwcpz5ftezi0", "type": "text", "x": 926, "y": 5281.25, "width": 788.8, "height": 260.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2074715751, "version": 1, "versionNonce": 730701520, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "wal_level=replica   archive_mode=on   archive_timeout=300\narchive_command=test ! -f /backups/wal/%f && cp %p /backups/wal/%f\n\n$ backend/scripts/backup_base.sh           # -> backups/base/20261106T113211Z\nSELECT now();                               -- 11:34:20, 525 toilets\nDELETE FROM amenity_points WHERE kind_code = 'toilet';   -- 11:34:26, 0 toilets\n$ backend/scripts/restore_pitr.sh 20261106T113211Z \"2026-11-06 11:34:20+00\" 5434\n\nLOG:  starting point-in-time recovery to 2026-11-06 11:34:20+00\nLOG:  recovery stopping before commit of transaction 2144\n\nrestored:  toilets 525 | tag links 827        live:  toilets 0 | tag links 0\n$ backend/scripts/backup_prune.sh           # keeps the newest 3 base backups", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "wal_level=replica   archive_mode=on   archive_timeout=300\narchive_command=test ! -f /backups/wal/%f && cp %p /backups/wal/%f\n\n$ backend/scripts/backup_base.sh           # -> backups/base/20261106T113211Z\nSELECT now();                               -- 11:34:20, 525 toilets\nDELETE FROM amenity_points WHERE kind_code = 'toilet';   -- 11:34:26, 0 toilets\n$ backend/scripts/restore_pitr.sh 20261106T113211Z \"2026-11-06 11:34:20+00\" 5434\n\nLOG:  starting point-in-time recovery to 2026-11-06 11:34:20+00\nLOG:  recovery stopping before commit of transaction 2144\n\nrestored:  toilets 525 | tag links 827        live:  toilets 0 | tag links 0\n$ backend/scripts/backup_prune.sh           # keeps the newest 3 base backups", "autoResize": false, "lineHeight": 1.25}, {"id": "3r13w0pddo7k3n79ly83", "type": "text", "x": 1834, "y": 5235.25, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1172218940, "version": 1, "versionNonce": 1763673066, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "6yldvuo19s8pdmii8h0k", "type": "text", "x": 1834, "y": 5268.25, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 401188111, "version": 1, "versionNonce": 288989183, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• 525 → 0 → 525 toilets, recovered in 19 s, in a throw-away container", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 525 → 0 → 525 toilets, recovered in 19 s, in a throw-away container", "autoResize": false, "lineHeight": 1.25}, {"id": "z9118eqnjqd742zqn3yj", "type": "text", "x": 1834, "y": 5300.0, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1681582698, "version": 1, "versionNonce": 62639139, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• After copying back: identical ids, md5 75fbe36b... matches on both sides", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• After copying back: identical ids, md5 75fbe36b... matches on both sides", "autoResize": false, "lineHeight": 1.25}, {"id": "ys5gesel7pz7lsqdalc9", "type": "text", "x": 1834, "y": 5331.75, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1476247218, "version": 1, "versionNonce": 649141027, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Base backup: 70 s, 225 MB. Logical dump: 46 s, 80 MB (database 1.4 GB)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Base backup: 70 s, 225 MB. Logical dump: 46 s, 80 MB (database 1.4 GB)", "autoResize": false, "lineHeight": 1.25}, {"id": "pr85sbyhlf3gmogoovmg", "type": "text", "x": 1834, "y": 5363.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 967578946, "version": 1, "versionNonce": 566739667, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• pg_stat_archiver: 9 segments archived, 0 failed", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• pg_stat_archiver: 9 segments archived, 0 failed", "autoResize": false, "lineHeight": 1.25}, {"id": "kfs1ns97ix7nx7aiq736", "type": "text", "x": 1834, "y": 5395.25, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1281989190, "version": 1, "versionNonce": 912249892, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Limit: the archive is on the same laptop; backups and pruning are run by hand", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Limit: the archive is on the same laptop; backups and pruning are run by hand", "autoResize": false, "lineHeight": 