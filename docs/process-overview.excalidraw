run as berlin_ro\n25 ready-made SQL patterns", "autoResize": false, "lineHeight": 1.25}, {"id": "t3mc9yxsx85s9wdtuwsv", "type": "text", "x": 0, "y": 1079.5, "width": 2640, "height": 55.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 877862536, "version": 1, "versionNonce": 187712512, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2  The database: before and after", "fontSize": 44, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2  The database: before and after", "autoResize": false, "lineHeight": 1.25}, {"id": "y5zt87il11an3suxu3l3", "type": "text", "x": 0, "y": 1141.5, "width": 2640, "height": 27.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 965835575, "version": 1, "versionNonce": 2125795195, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Same data, different design. Left: the first version. Right: the real tables of schema v2 with their row counts.", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Same data, different design. Left: the first version. Right: the real tables of schema v2 with their row counts.", "autoResize": false, "lineHeight": 1.25}, {"id": "0q14nzf2328m6wq1ivzl", "type": "rectangle", "x": 0, "y": 1203.0, "width": 1060, "height": 702.25, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1491299297, "version": 1, "versionNonce": 1445987171, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "w653rpfn5u6xvlef6ikd", "type": "text", "x": 24, "y": 1221.0, "width": 507.20000000000005, "height": 37.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1959149174, "version": 1, "versionNonce": 865453835, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "BEFORE (v1): one table per layer", "fontSize": 30, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "BEFORE (v1): one table per layer", "autoResize": false, "lineHeight": 1.25}, {"id": "m40rkp2zjczzkob7ith7", "type": "text", "x": 24, "y": 1275.0, "width": 1012, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1626363286, "version": 1, "versionNonce": 28317734, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "15 tables with the same columns. Only the name of the type column differed.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "15 tables with the same columns. Only the name of the type column differed.", "autoResize": false, "lineHeight": 1.25}, {"id": "yit7f3oqqcael8wrntox", "type": "rectangle", "x": 24, "y": 1315.25, "width": 1012, "height": 192, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1923611002, "version": 1, "versionNonce": 916238487, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "mg6zp1x4miuuh1je2cv6", "type": "text", "x": 40, "y": 1331.25, "width": 769.28, "height": 160.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2045223301, "version": 1, "versionNonce": 829777805, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "kitas          (source_id, name, <type>, catalog_id, district_id, attrs, geom)\ntoilets        (source_id, name, <type>, catalog_id, district_id, attrs, geom)\nev_chargers    (source_id, name, <type>, catalog_id, district_id, attrs, geom)\nstreet_trees   (source_id, name, <type>, catalog_id, district_id, attrs, geom)\n... 11 more tables with the same columns\n\none Kita cell:     'Offene-Arbeit/Situationsansatz'\none charger cell:  'AC Typ 2; DC CCS'", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "kitas          (source_id, name, <type>, catalog_id, district_id, attrs, geom)\ntoilets        (source_id, name, <type>, catalog_id, district_id, attrs, geom)\nev_chargers    (source_id, name, <type>, catalog_id, district_id, attrs, geom)\nstreet_trees   (source_id, name, <type>, catalog_id, district_id, attrs, geom)\n... 11 more tables with the same columns\n\none Kita cell:     'Offene-Arbeit/Situationsansatz'\none charger cell:  'AC Typ 2; DC CCS'", "autoResize": false, "lineHeight": 1.25}, {"id": "43fdnt6qt8cwnbzdwekj", "type": "text", "x": 24, "y": 1535.25, "width": 419.84000000000003, "height": 30.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 585004404, "version": 1, "versionNonce": 1480556687, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "What was wrong, with the evidence", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What was wrong, with the evidence", "autoResize": false, "lineHeight": 1.25}, {"id": "yfmxip9nwulpq4ndveu0", "type": "text", "x": 36, "y": 1575.25, "width": 988, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1305852915, "version": 1, "versionNonce": 1199380275, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• The same structure 15 times: the density report was 14 hand-written subqueries\n  (design-decisions.md, D1)", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• The same structure 15 times: the density report was 14 hand-written subqueries\n  (design-decisions.md, D1)", "autoResize": false, "lineHeight": 1.25}, {"id": "7g201ifp5m9kvet4669v", "type": "text", "x": 36, "y": 1635.25, "width": 988, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 118590891, "version": 1, "versionNonce": 1816268291, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Lists inside one cell: 950 of 2,905 Kitas and 247 of 4,960 chargers carried several values,\n  so they could not be counted or filtered (D3)", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Lists inside one cell: 950 of 2,905 Kitas and 247 of 4,960 chargers carried several values,\n  so they could not be counted or filtered (D3)", "autoResize": false, "lineHeight": 1.25}, {"id": "o4kk8hshde1g4ha4o274", "type": "text", "x": 36, "y": 1695.25, "width": 988, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 142799106, "version": 1, "versionNonce": 923171924, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Operator and species names repeated as free text on up to 962,000 rows", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Operator and species names repeated as free text on up to 962,000 rows", "autoResize": false, "lineHeight": 1.25}, {"id": "x0u8xo5ndmj8kp37q0w6", "type": "text", "x": 36, "y": 1730.25, "width": 988, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 247120214, "version": 1, "versionNonce": 1503963050, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Every import deleted and reinserted, so every place got a new id; the toilet key matched 0 of\n  525 rows (D4)", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Every import deleted and reinserted, so every place got a new id; the toilet key matched 0 of\n  525 rows (D4)", "autoResize": false, "lineHeight": 1.25}, {"id": "iprskv77kx8p4k1781ez", "type": "text", "x": 36, "y": 1790.25, "width": 988, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 517965799, "version": 1, "versionNonce": 163730312, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Uniqueness and kind/geometry consistency were conventions in the importer, not rules in the\n  database", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Uniqueness and kind/geometry consistency were conventions in the importer, not rules in the\n  database", "autoResize": false, "lineHeight": 1.25}, {"id": "evg7o485bl9ng2vs21g8", "type": "text", "x": 36, "y": 1850.25, "width": 988, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 780227137, "version": 1, "versionNonce": 1781510177, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• No many-to-many relation, no backups, no record of what was imported", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• No many-to-many relation, no backups, no record of what was imported", "autoResize": false, "lineHeight": 1.25}, {"id": "dkcqe9twt67103pl276x", "type": "rectangle", "x": 1120, "y": 1203.0, "width": 1520, "height": 920, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2057111565, "version": 1, "versionNonce": 1660234640, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "n5vzyhh1s3ooos30lc1t", "type": "text", "x": 1144, "y": 1221.0, "