eStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1196258825, "version": 1, "versionNonce": 1425265633, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "pz1p0f1h0vk2uncztffx", "type": "text", "x": 24, "y": 4018.25, "width": 46, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1079757337, "version": 1, "versionNonce": 673122754, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "5", "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "5", "autoResize": false, "lineHeight": 1.25}, {"id": "9dq5o6odp8ltrqmgn3ld", "type": "text", "x": 86, "y": 4017.25, "width": 663.2, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1726090547, "version": 1, "versionNonce": 1580263269, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Imports are all-or-nothing and safe to repeat", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Imports are all-or-nothing and safe to repeat", "autoResize": false, "lineHeight": 1.25}, {"id": "innhbml10arbos91o0q1", "type": "text", "x": 24, "y": 4071.25, "width": 752, "height": 131.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 872415338, "version": 1, "versionNonce": 267378938, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Each layer loads inside one transaction: if anything fails, the\nlayer is exactly as it was before. Rows are matched by their source\nkey and only written when something changed, so ids never change.\nEvery run leaves an audit row, and two imports of the same layer\ncannot run at once.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Each layer loads inside one transaction: if anything fails, the\nlayer is exactly as it was before. Rows are matched by their source\nkey and only written when something changed, so ids never change.\nEvery run leaves an audit row, and two imports of the same layer\ncannot run at once.", "autoResize": false, "lineHeight": 1.25}, {"id": "atlyovv601fxjvfb4s00", "type": "text", "x": 910, "y": 4007.25, "width": 319.09999999999997, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1476395011, "version": 1, "versionNonce": 1963068416, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "One layer import, step by step", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One layer import, step by step", "autoResize": false, "lineHeight": 1.25}, {"id": "oykbeitnapss5uq189sw", "type": "rectangle", "x": 910, "y": 4037.25, "width": 900, "height": 272, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1583337760, "version": 1, "versionNonce": 409769733, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "qua9mjt20q92nsti9jxs", "type": "text", "x": 926, "y": 4053.25, "width": 769.28, "height": 240.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 492864921, "version": 1, "versionNonce": 1109383858, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "SELECT pg_try_advisory_lock(:k, :catalog_id);     -- one live import per layer\nimport_run: status = 'running'                    -- committed on its own\nBEGIN;\n  bulk-load the layer into a staging table, compute district_id there\n  INSERT INTO amenity_points ... SELECT ... FROM staging\n  ON CONFLICT (kind_code, source_id) DO UPDATE SET ...\n    WHERE (current values) IS DISTINCT FROM (EXCLUDED values);\n  delete rows that are no longer in the source\nCOMMIT;                                           -- or ROLLBACK on any error\nimport_run: status = 'committed' | 'failed' + counts and error text\nREFRESH MATERIALIZED VIEW CONCURRENTLY ...;       -- after the import\nSELECT pg_advisory_unlock(:k, :catalog_id);", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SELECT pg_try_advisory_lock(:k, :catalog_id);     -- one live import per layer\nimport_run: status = 'running'                    -- committed on its own\nBEGIN;\n  bulk-load the layer into a staging table, compute district_id there\n  INSERT INTO amenity_points ... SELECT ... FROM staging\n  ON CONFLICT (kind_code, source_id) DO UPDATE SET ...\n    WHERE (current values) IS DISTINCT FROM (EXCLUDED values);\n  delete rows that are no longer in the source\nCOMMIT;                                           -- or ROLLBACK on any error\nimport_run: status = 'committed' | 'failed' + counts and error text\nREFRESH MATERIALIZED VIEW CONCURRENTLY ...;       -- after the import\nSELECT pg_advisory_unlock(:k, :catalog_id);", "autoResize": false, "lineHeight": 1.25}, {"id": "3zhfytm5xina1x2ym1wo", "type": "text", "x": 1834, "y": 4007.25, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1494742776, "version": 1, "versionNonce": 1540093138, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "h7qc4gzrixtm6n5pfdas", "type": "text", "x": 1834, "y": 4040.25, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 887305502, "version": 1, "versionNonce": 860851509, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Repeat import of all 980,440 rows: 0 inserted / 0 updated / 0 deleted, md5 of\n  all ids and tag links identical", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Repeat import of all 980,440 rows: 0 inserted / 0 updated / 0 deleted, md5 of\n  all ids and tag links identical", "autoResize": false, "lineHeight": 1.25}, {"id": "bg5mnzi8vlmw2xx1km3c", "type": "text", "x": 1834, "y": 4095.75, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 602188109, "version": 1, "versionNonce": 1156481123, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Rollback demo (--fail-after-rows): row counts unchanged, import_run says\n  'failed' with the error", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Rollback demo (--fail-after-rows): row counts unchanged, import_run says\n  'failed' with the error", "autoResize": false, "lineHeight": 1.25}, {"id": "kq40x4g1ty25fob1ntaq", "type": "text", "x": 1834, "y": 4151.25, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1923572131, "version": 1, "versionNonce": 1091093905, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Audit after the full load: 35 committed, 3 failed", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Audit after the full load: 35 committed, 3 failed", "autoResize": false, "lineHeight": 1.25}, {"id": "wuvph3kkly25j09jz9jn", "type": "text", "x": 1834, "y": 4183.0, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1727227509, "version": 1, "versionNonce": 1774501354, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• A crashed run's 'running' row is closed as 'abandoned' by the next run; a\n  second live import is refused", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• A crashed run's 'running' row is closed as 'abandoned' by the next run; a\n  second live import is refused", "autoResize": false, "lineHeight": 1.25}, {"id": "qnfz05nof3gqlk9ohk9m", "type": "text", "x": 1834, "y": 4238.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 256935986, "version": 1, "versionNonce": 996714786, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• 20 automatic tests cover the importer", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 20 automatic tests cover the importer", "autoResize": false, "lineHeight": 1.25}, {"id": "k5k0hx7vfmdujm120xid", "type": "text", "x": 1834, "y": 4270.25, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2013422308, "version": 1, "versionNonce": 493984860, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• District assignment computed before writing: 306 s → 1 s when no boundary\n  changed", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• District assignment computed before writing: 306 s → 1 s when no boundary\n  changed", "autoResize": false, "lineHeight": 1.25}, {"id": "j0jozkvcm7nccpucfdwg", "type": "text", "x": 1834, "y": 4341.75, "width": 143.20000000000002, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1146114684, "version": 1, "versionNonce": 592871696, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Where to look", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where to look", "autoResize": false, "lineHeight": 1.25}, {"id": "i5bv8ssg8tfqglvamv0n", "type": "text", "x": 1834, "y": 4374.75, "width": 466.71999999999997, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 155333766, "version": 1, "versionNonce": 1977277093, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "docs/schema-v2/acid-and-transactions.md\ndocs/schema-v2/design-decisions.md  D4, D9, D10\ndocs/schema-v2/import-mapping.md", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "docs/schema-v2/acid-and-transactions.md\ndocs/schema-v2/design-decisions.md  D4, D9, D10\ndocs/schema-v2/import-mapping.md", "autoResize": false, "lineHeight": 1.25}, {"id": "rycrz12vtjnr8dqi03y1", "type": "rectangle", "x": 0, "y": 4496.75, "width": 800, "height": 682.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1520806941, "version": 1, "versionNonce": 19510745, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "qg781b1fgac39kozmo82", "type": "rectangle", "x": 890, "y": 4496.75, "width": 1750, "height": 682.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 324101269, "version": 1, "versionNonce": 951941158, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "mx0s1fznkev3dh5shwf5", "type": "arrow", "x": 808, "y": 4838.0, "width": 74, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 21710437, "version": 1, "versionNonce": 1046148585, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [74, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "ky1vvydetcml3kd37zpo", "type": "text", "x": 808, "y": 4806.0, "width": 74, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1434408467, "version": 1, "versionNonce": 24507755, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "proof", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "proof", "autoResize": false, "lineHeight": 1.25}, {"id": "0ws43rlbz4osox77qmic", "type": "rectangle", "x": 24, "y": 4520.75, "width": 46, "height": 46, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#1971c2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1924384310, "version": 1, "versionNonce": 2078504903, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "rbx5z3xet2041c16g9c0", "type": "text", "x": 24, "y": 4527.75, "width": 46, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1510215026, "version": 1, "versionNonce": 371671287, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "6", "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "6", "autoResize": false, "lineHeight": 1.25}, {"id": "wsk329z78s59s7ypfuio", "type": "text", "x": 86, "y": 4526.75, "width": 575.84, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1824137692, "version": 1, "versionNonce": 305217596, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Map queries stay fast on a million rows", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Map queries stay fast on a million rows", "autoResize": false, "lineHeight": 1.25}, {"id": "5qc2o2r09nojuskk0tpc", "type": "text", "x": 24, "y": 4580.75, "width": 752, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 160813158, "version": 1, "versionNonce": 1514099042, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "We measured the slow queries and fixed each one with the right tool:\na spatial index walk for 'nearest', partitions so tree queries skip\neverything else, a JSON index, and a saved result for the heavy\nreport. One index was tried and rejected.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "We measured the slow queries and fixed each one with the right tool:\na spatial index walk for 'nearest', partitions so tree queries skip\neverything else, a JSON index, and a saved result for the heavy\nreport. One index was tried and rejected.", "autoResize": false, "lineHeight": 1.25}, {"id": "tm1tiw4kmuap64w008sx", "type": "text", "x": 910, "y": 4516.75, "width": 391.69, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2040300918, "version": 1, "versionNonce": 594384188, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The nearest-amenity query (shortened)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The nearest-amenity query (shortened)", "autoResize": false, "lineHeight": 1.25}, {"id": "5f1ozmu8bccmvp948vgp", "type": "rectangle", "x": 910, "y": 4546.75, "width": 900, "height": 272, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1399098250, "version": 1, "versionNonce": 718737525, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "2g2spjvnwrrutz9rrjy3", "type": "text", "x": 926, "y": 4562.75, "width": 740.0, "height": 240.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2041793205, "version": 1, "versionNonce": 896149490, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "FROM kinds k\nCROSS JOIN pt\nCROSS JOIN LATERAL (\n  SELECT p.id, p.name, ST_Distance(p.geom, pt.geom) AS distance_m\n  FROM amenity_points p\n  WHERE p.kind_code = k.kind_code       -- planner opens one partition only\n  ORDER BY p.geom <-> pt.geom           -- walks the GiST index, no sort\n  LIMIT 1\n) n\n\nEXPLAIN: Index Scan ... Order By: (geom <-> ...), 8 buffer hits\nSame question with ORDER BY ST_Distance(...): seq scan + sort, 2 s", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "FROM kinds k\nCROSS JOIN pt\nCROSS JOIN LATERAL (\n  SELECT p.id, p.name, ST_Distance(p.geom, pt.geom) AS distance_m\n  FROM amenity_points p\n  WHERE p.kind_code = k.kind_code       -- planner opens one partition only\n  ORDER BY p.geom <-> pt.geom           -- walks the GiST index, no sort\n  LIMIT 1\n) n\n\nEXPLAIN: Index Scan ... Order By: (geom <-> ...), 8 buffer hits\nSame question with ORDER BY ST_Distance(...): seq scan + sort, 2 s", "autoResize": false, "lineHeight": 1.25}, {"id": "isnmlnzyfya02k0lsyms", "type": "text", "x": 1834, "y": 4516.75, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1415874294, "version": 1, "versionNonce": 1845748297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "5ooshae1t44tlssxx5uf", "type": "text", "x": 1834, "y": 4549.75, "width": 466.64000000000004, "height": 22.5, "angle": 0, "strokeColo