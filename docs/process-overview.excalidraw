"roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 598433857, "version": 1, "versionNonce": 458972474, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "proof", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "proof", "autoResize": false, "lineHeight": 1.25}, {"id": "7np9rwrsgk2017k5frgh", "type": "rectangle", "x": 24, "y": 3634.75, "width": 46, "height": 46, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#1971c2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 994192934, "version": 1, "versionNonce": 359606319, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "lxfpda81tkivoneowdz0", "type": "text", "x": 24, "y": 3641.75, "width": 46, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1929308302, "version": 1, "versionNonce": 664619970, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4", "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "4", "autoResize": false, "lineHeight": 1.25}, {"id": "k0afuvnvrop0z6w0mhw2", "type": "text", "x": 86, "y": 3640.75, "width": 575.84, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1467042994, "version": 1, "versionNonce": 279942030, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The database itself says no to bad data", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The database itself says no to bad data", "autoResize": false, "lineHeight": 1.25}, {"id": "ddjde9ym0j54fcijxn4k", "type": "text", "x": 24, "y": 3694.75, "width": 752, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1762727203, "version": 1, "versionNonce": 1277228397, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The rules live in the tables, not in the Python code, so even a\nhand-typed INSERT cannot break them. Each test tries to insert\nsomething wrong and checks that the database refuses it with the\nright rule.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The rules live in the tables, not in the Python code, so even a\nhand-typed INSERT cannot break them. Each test tries to insert\nsomething wrong and checks that the database refuses it with the\nright rule.", "autoResize": false, "lineHeight": 1.25}, {"id": "zig0umyucjdzcj8epavr", "type": "text", "x": 910, "y": 3630.75, "width": 433.17, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 3140810, "version": 1, "versionNonce": 1328729479, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "What the constraint tests try (shortened)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What the constraint tests try (shortened)", "autoResize": false, "lineHeight": 1.25}, {"id": "dy02xbahv7yrgivsixxe", "type": "rectangle", "x": 910, "y": 3660.75, "width": 900, "height": 252, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1903644615, "version": 1, "versionNonce": 295313427, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "iex9rf5aw5btdggolllb", "type": "text", "x": 926, "y": 3676.75, "width": 759.52, "height": 220.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1320998314, "version": 1, "versionNonce": 2039498907, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "INSERT INTO tree_detail (..., height_m) VALUES (..., 0);\n  -> refused: CHECK (height_m > 0)\n\nINSERT INTO amenity_points (kind_code, ...) VALUES (<an area kind>, ...);\n  -> refused: FOREIGN KEY (kind_code, geom_family) -> amenity_kind\n\nINSERT INTO amenity_point_tag ...        -- a Kita tag on a toilet\n  -> refused: FOREIGN KEY (kind_code, category_code) -> kind_tag_category\n\nINSERT INTO amenity_points ...           -- same (kind_code, source_id) twice\n  -> refused: UNIQUE (kind_code, source_id)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "INSERT INTO tree_detail (..., height_m) VALUES (..., 0);\n  -> refused: CHECK (height_m > 0)\n\nINSERT INTO amenity_points (kind_code, ...) VALUES (<an area kind>, ...);\n  -> refused: FOREIGN KEY (kind_code, geom_family) -> amenity_kind\n\nINSERT INTO amenity_point_tag ...        -- a Kita tag on a toilet\n  -> refused: FOREIGN KEY (kind_code, category_code) -> kind_tag_category\n\nINSERT INTO amenity_points ...           -- same (kind_code, source_id) twice\n  -> refused: UNIQUE (kind_code, source_id)", "autoResize": false, "lineHeight": 1.25}, {"id": "3fopqnbgr515je7dtnba", "type": "text", "x": 1834, "y": 3630.75, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 297889528, "version": 1, "versionNonce": 1271857548, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "zitcilvdudohbvjhxiw0", "type": "text", "x": 1834, "y": 3663.75, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2139000959, "version": 1, "versionNonce": 340557523, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• 18 automatic tests, one per rule", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 18 automatic tests, one per rule", "autoResize": false, "lineHeight": 1.25}, {"id": "ie5qu5nvvbjxq2itjrsl", "type": "text", "x": 1834, "y": 3695.5, "width": 782, "height": 71.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 633693523, "version": 1, "versionNonce": 1096100104, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• A real catch: a crown diameter of 0.04 m rounded to 0.0, the CHECK refused it\n  and the import rolled back after 15 minutes. The database found a bug our\n  cleaning code missed", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• A real catch: a crown diameter of 0.04 m rounded to 0.0, the CHECK refused it\n  and the import rolled back after 15 minutes. The database found a bug our\n  cleaning code missed", "autoResize": false, "lineHeight": 1.25}, {"id": "zrjwarboitu98207m8s2", "type": "text", "x": 1834, "y": 3774.75, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1020090805, "version": 1, "versionNonce": 1184999469, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Polygons must pass CHECK (ST_IsValid(geom))", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Polygons must pass CHECK (ST_IsValid(geom))", "autoResize": false, "lineHeight": 1.25}, {"id": "vsc1y5ga04ta1mbdxo09", "type": "text", "x": 1834, "y": 3806.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 423312600, "version": 1, "versionNonce": 119416624, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Rejected: a trigger, or a check in the importer only (D2)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Rejected: a trigger, or a check in the importer only (D2)", "autoResize": false, "lineHeight": 1.25}, {"id": "084d33y5f8ntyqzu2qvc", "type": "text", "x": 1834, "y": 3854.25, "width": 143.20000000000002, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1938249647, "version": 1, "versionNonce": 1695799956, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Where to look", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where to look", "autoResize": false, "lineHeight": 1.25}, {"id": "tcgdrkgh2jlgo44hl7b8", "type": "text", "x": 1834, "y": 3887.25, "width": 378.88, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1902351640, "version": 1, "versionNonce": 1538369962, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "docs/schema-v2/design-decisions.md  D2\ndocs/implementation-log.md  (phase 2)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "docs/schema-v2/design-decisions.md  D2\ndocs/implementation-log.md  (phase 2)", "autoResize": false, "lineHeight": 1.25}, {"id": "029xt0mvxs8u7qojwyy4", "type": "rectangle", "x": 0, "y": 3987.25, "width": 800, "height": 473.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1908540081, "version": 1, "versionNonce": 1815800695, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "lock