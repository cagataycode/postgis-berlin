6819, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "p7gotzuv1g36dgz39t56", "type": "text", "x": 24, "y": 5644.25, "width": 46, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 47258001, "version": 1, "versionNonce": 1374505795, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "8", "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "8", "autoResize": false, "lineHeight": 1.25}, {"id": "dcdnfyvivl49to2dmv20", "type": "text", "x": 86, "y": 5643.25, "width": 590.4, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 432793862, "version": 1, "versionNonce": 620910137, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Anyone can query it, nobody can break it", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Anyone can query it, nobody can break it", "autoResize": false, "lineHeight": 1.25}, {"id": "wzjb57kpwycb7nbu7xuw", "type": "text", "x": 24, "y": 5697.25, "width": 752, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1679932223, "version": 1, "versionNonce": 346785491, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The app has a tab where you type your own SQL. It connects as a\nseparate database user that can only read, so a destructive\nstatement is stopped by the database even if the Python check were\nbypassed.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The app has a tab where you type your own SQL. It connects as a\nseparate database user that can only read, so a destructive\nstatement is stopped by the database even if the Python check were\nbypassed.", "autoResize": false, "lineHeight": 1.25}, {"id": "1h8meyz35ew6itkew6k5", "type": "text", "x": 910, "y": 5633.25, "width": 319.09999999999997, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 824931692, "version": 1, "versionNonce": 61433198, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The read-only role (shortened)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The read-only role (shortened)", "autoResize": false, "lineHeight": 1.25}, {"id": "hjc8nuqt3kbnq4g08uxx", "type": "rectangle", "x": 910, "y": 5663.25, "width": 900, "height": 192, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 119201896, "version": 1, "versionNonce": 1693964975, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "lpr3o2ygranw9s70yi1g", "type": "text", "x": 926, "y": 5679.25, "width": 769.28, "height": 160.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 625842171, "version": 1, "versionNonce": 1844613883, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "CREATE ROLE berlin_ro LOGIN PASSWORD '...';\nGRANT USAGE ON SCHEMA public TO berlin_ro;\nGRANT SELECT ON ALL TABLES IN SCHEMA public TO berlin_ro;\nALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO berlin_ro;\nALTER ROLE berlin_ro SET default_transaction_read_only = on;\n\nPOST /sql/run   -> its own engine on DATABASE_URL_RO (role berlin_ro)\nDELETE ...      -> refused by the role, not only by the SELECT check", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CREATE ROLE berlin_ro LOGIN PASSWORD '...';\nGRANT USAGE ON SCHEMA public TO berlin_ro;\nGRANT SELECT ON ALL TABLES IN SCHEMA public TO berlin_ro;\nALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO berlin_ro;\nALTER ROLE berlin_ro SET default_transaction_read_only = on;\n\nPOST /sql/run   -> its own engine on DATABASE_URL_RO (role berlin_ro)\nDELETE ...      -> refused by the role, not only by the SELECT check", "autoResize": false, "lineHeight": 1.25}, {"id": "fm7avr3fvcovfer7nmvc", "type": "text", "x": 1834, "y": 5633.25, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1346674069, "version": 1, "versionNonce": 1616488947, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "eiei3dd75z17ba1b4eb5", "type": "text", "x": 1834, "y": 5666.25, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 164030583, "version": 1, "versionNonce": 1227123775, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Tests assert berlin_ro cannot DELETE, even with the Python check bypassed", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Tests assert berlin_ro cannot DELETE, even with the Python check bypassed", "autoResize": false, "lineHeight": 1.25}, {"id": "ndqndu2djavi2wxeo4z1", "type": "text", "x": 1834, "y": 5698.0, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1879018938, "version": 1, "versionNonce": 1928271650, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• 14 automatic tests for the playground", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 14 automatic tests for the playground", "autoResize": false, "lineHeight": 1.25}, {"id": "os1zv8q33nhkaothd9iu", "type": "text", "x": 1834, "y": 5729.75, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 261742110, "version": 1, "versionNonce": 2069557117, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• pg_stat_statements (migration 0013) lists the slowest queries after a session", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• pg_stat_statements (migration 0013) lists the slowest queries after a session", "autoResize": false, "lineHeight": 1.25}, {"id": "9fvg4rzok7ytbevbv6vx", "type": "text", "x": 1834, "y": 5761.5, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1349846393, "version": 1, "versionNonce": 356692891, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Gap we name: the API's own read endpoints still connect as the owner role in\n  development", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Gap we name: the API's own read endpoints still connect as the owner role in\n  development", "autoResize": false, "lineHeight": 1.25}, {"id": "5qi5wdo8rysigdery4sx", "type": "text", "x": 1834, "y": 5833.0, "width": 143.20000000000002, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 553180011, "version": 1, "versionNonce": 1994801977, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Where to look", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where to look", "autoResize": false, "lineHeight": 1.25}, {"id": "zamfc3n7xbyjuuqogmpd", "type": "text", "x": 1834, "y": 5866.0, "width": 388.64, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId