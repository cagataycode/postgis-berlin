 "containerId": null, "originalText": "1", "autoResize": false, "lineHeight": 1.25}, {"id": "q0b2x583zzx5sjqf1bn7", "type": "text", "x": 86, "y": 2356.5, "width": 604.96, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2011317610, "version": 1, "versionNonce": 834698230, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "One model instead of 15 look-alike tables", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One model instead of 15 look-alike tables", "autoResize": false, "lineHeight": 1.25}, {"id": "txh15a4fdt8kle1jd4a8", "type": "text", "x": 24, "y": 2410.5, "width": 752, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 203471890, "version": 1, "versionNonce": 1476483701, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every place that is a dot on the map lives in one table, every place\nthat is a shape lives in a second one. A 'kind' column says whether\na row is a school, a toilet or a tree. A new kind of amenity is a\nnew row, not a new table, and one query covers all kinds.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Every place that is a dot on the map lives in one table, every place\nthat is a shape lives in a second one. A 'kind' column says whether\na row is a school, a toilet or a tree. A new kind of amenity is a\nnew row, not a new table, and one query covers all kinds.", "autoResize": false, "lineHeight": 1.25}, {"id": "vsofmoz1j3it2wv8l97y", "type": "text", "x": 910, "y": 2346.5, "width": 350.21, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1701823659, "version": 1, "versionNonce": 1667116265, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The table definitions (shortened)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The table definitions (shortened)", "autoResize": false, "lineHeight": 1.25}, {"id": "70l8p9au931oeyczqfc1", "type": "rectangle", "x": 910, "y": 2376.5, "width": 900, "height": 252, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 622837935, "version": 1, "versionNonce": 1865261350, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "b146hmjqqvnowpjpuv1v", "type": "text", "x": 926, "y": 2392.5, "width": 808.3199999999999, "height": 220.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2019065118, "version": 1, "versionNonce": 676330163, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "CREATE TABLE amenity_kind (\n  ...\n  geom_family varchar(16) NOT NULL CHECK (geom_family IN ('point', 'area')),\n  UNIQUE (code, geom_family)\n);\nCREATE TABLE amenity_points (\n  ...\n  geom_family varchar(16) NOT NULL DEFAULT 'point' CHECK (geom_family = 'point'),\n  UNIQUE (kind_code, source_id),\n  FOREIGN KEY (kind_code, geom_family) REFERENCES amenity_kind (code, geom_family)\n) PARTITION BY LIST (kind_code);", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CREATE TABLE amenity_kind (\n  ...\n  geom_family varchar(16) NOT NULL CHECK (geom_family IN ('point', 'area')),\n  UNIQUE (code, geom_family)\n);\nCREATE TABLE amenity_points (\n  ...\n  geom_family varchar(16) NOT NULL DEFAULT 'point' CHECK (geom_family = 'point'),\n  UNIQUE (kind_code, source_id),\n  FOREIGN KEY (kind_code, geom_family) REFERENCES amenity_kind (code, geom_family)\n) PARTITION BY LIST (kind_code);", "autoResize": false, "lineHeight": 1.25}, {"id": "178g1r002fl9bssuff6s", "type": "text", "x": 1834, "y": 2346.5, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 611331778, "version": 1, "versionNonce": 393687038, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "p6isw5syx6x0581jpi1c", "type": "text", "x": 1834, "y": 2379.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 558243422, "version": 1, "versionNonce": 1894576849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• 15 tables became 2: 975,765 points + 4,675 areas = 980,440 features", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 15 tables became 2: 975,765 points + 4,675 areas = 980,440 features", "autoResize": false, "lineHeight": 1.25}, {"id": "8gl80h570zn3f7ayjzu6", "type": "text", "x": 1834, "y": 2411.25, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1827521732, "version": 1, "versionNonce": 1550612916, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• The density report went from 14 hand-written subqueries to one GROUP BY", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• The density report went from 14 hand-written subqueries to one GROUP BY", "autoResize": false, "lineHeight": 1.25}, {"id": "yvnz8ugbrcnn23l5vgl6", "type": "text", "x": 1834, "y": 2443.0, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1463343611, "version": 1, "versionNonce": 970400449, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• An area kind inserted into amenity_points is refused by the foreign key\n  (tested)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• An area kind inserted into amenity_points is refused by the foreign key\n  (tested)", "autoResize": false, "lineHeight": 1.25}, {"id": "h9mfbs1q7k2wc0wtbsyk", "type": "text", "x": 1834, "y": 2498.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 995259465, "version": 1, "versionNonce": 571348356, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• API paths did not change, so the map code did not change (D12)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• API paths did not change, so the map code did not change (D12)", "autoResize": false, "lineHeight": 1.25}, {"id": "gh52kjw5buxoeevxswie", "type": "text", "x": 1834, "y": 2546.25, "width": 143.20000000000002, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1350223535, "version": 1, "versionNonce": 231264986, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Where to look", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where to look", "autoResize": false, "lineHeight": 1.25}, {"id": "iejit96ypqgpf7bz3ipj", "type": "text", "x": 1834, "y": 2579.25, "width": 466.71999999999997, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 810568574, "version": 1, "versionNonce": 594708221, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "docs/schema-v2/design-decisions.md  D1, D2, D12\ndocs/schema-v2/erd.md", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "docs/schema-v2/design-decisions.md  D1, D2, D12\ndocs/schema-v2/erd.md", "autoResize": false, "lineHeight": 1.25}, {"id": "7x6ri142r6ap4hm7bk05", "type": "rectangle", "x": 0, "y": 2684.5, "width": 800, "height": 372.25, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1942083061, "version": 1, "versionNonce": 1364831067, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "aotu1jm049z5w4wl5xeu", "type": "rectangle", "x": 890, "y": 2684.5, "width": 1750, "height": 372.25, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1651597483, "version": 1, "versionNonce": 689568504, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "fs0e35mn73o3xznvibfm", "type": "arrow", "x": 808, "y": 2870.625, "width": 74, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1430361023, "version": 1, "versionNonce": 1444956091, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [74, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "ulxttc1ju8bxx319l9ho", "type": "text", "x": 808, "y": 2838.625, "width": 74, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1187511565, "version": 1, "versionNonce": 1402453891, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "proof", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "proof", "autoResize": false, "lineHeight": 1.25}, {"id": "ms93u0g7hgdn2urmtl2g", "type": "rectangle", "x": 24, "y": 2708.5, "width": 46, "height": 46, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#1971c2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1719243758, "version": 1, "versionNonce": 1180423076, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "mh6p14w17rpri6j5tp89", "type": "text", "x": 24, "y": 2715.5, "width": 46, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 791732148, "version": 1, "versionNonce": 835757817, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2", "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "2", "autoResize": false, "lineHeight": 1.25}, {"id": "3m15cfang8d5jj75bohe", "type": "text", "x": 86, "y": 2714.5, "width": 619.52, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1557050209, "version": 1, "versionNonce": 1399927646, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A place can carry many tags (many-to-many)", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A place can carry many tags (many-to-many)", "autoResize": false, "lineHeight": 1.25}, {"id": "dx59dd6tnpwgeakfishh", "type": "text", "x": 24, "y": 2768.5, "width": 752, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1761098958, "version": 1, "versionNonce": 507821169, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A charger can have several plug types and one plug type fits many\nchargers. A table in the middle holds one row per link. The link row\nalso repeats the kind and the tag category, so the database can\nrefuse a daycare tag on a toilet.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A charger can have several plug types and one plug type fits many\nchargers. A table in the middle holds one row per link. The link row\nalso repeats the kind and the tag category, so the database can\nrefuse a daycare tag on a toilet.", "autoResize": false, "lineHeight": 1.25}, {"id": "mwdsjrcczy1qrezqrapn", "type": "text", "x": 910, "y": 2704.5, "width": 516.13, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1355980077, "version": 1, "versionNonce": 827280156, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The junction table and the tag filter (shortened)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The junction table and the tag filter (shortened)", "autoResize": false, "lineHeight": 1.25}, {"id": "8xbd933nq9qxv3pi8koa", "type": "rectangle", "x": 910, "y": 2734.5, "width": 900, "height": 292, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 677610140, "version": 1, "versionNonce": 294325951, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "qrzhcbbe1frvzlalcof9", "type": "text", "x": 926, "y": 2750.5, "width": 827.84, "height": 260.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1086230675, "version": 1, "versionNonce": 302994950, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "CREATE TABLE amenity_point_tag (\n  point_id bigint, kind_code varchar(64), tag_id integer, category_code varchar(64),\n  PRIMARY KEY (point_id, tag_id),\n  FOREIGN KEY (point_id, kind_code)\n    REFERENCES amenity_points (id, kind_code) ON DELETE CASCADE,\n  FOREIGN KEY (tag_id, category_code) REFERENCES tag (id, category_code),\n  FOREIGN KEY (kind_code, category_code)\n    REFERENCES kind_tag_category (kind_code, category_code)\n);\n\n-- ?tag=1&tag=2 : keep places that have ALL chosen tags\n  AND apt.tag_id = ANY(CAST(:tag_ids AS integer[]))\nGROUP BY ... HAVING count(*) = CAST(:n_tags AS integer)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CREATE TABLE amenity_point_tag (\n  point_id bigint, kind_code varchar(64), tag_id integer, category_code varchar(64),\n  PRIMARY KEY (point_id, tag_id),\n  FOREIGN KEY (point_id, kind_code)\n    REFERENCES amenity_points (id, kind_code) ON DELETE CASCADE,\n  FOREIGN KEY (tag_id, category_code) REFERENCES tag (id, category_code),\n  FOREIGN KEY (kind_code, category_code)\n    REFERENCES kind_tag_category (kind_code, category_code)\n);\n\n-- ?tag=1&tag=2 : keep places that have ALL chosen tags\n  AND apt.tag_id = ANY(CAST(:tag_ids AS integer[]))\nGROUP BY ... HAVING count(*) = CAST(:n_tags AS integer)", "autoResize": false, "lineHeight": 1.25}, {"id": "j2m5lfoovvwrl0d5vyrj", "type": "text", "x": 1834, "y": 2704.5, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1700753236, "version": 1, "versionNonce": 1389560946, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "0scclmgxvs407ogpudgb", "type": "text", "x": 1834, "y": 2737.5, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1319325963, "version": 1, "versionNonce": 52793013, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Raw data: 7 connector types, 9 Kita approaches; 247 chargers and 950 Kitas\n  carry several", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Raw data: 7 connector types, 9 Kita approaches; 247 chargers and 950 Kitas\n  carry several", "autoResize": false, "lineHeight": 1.25}, {"id": "inqgayh6u96ofb5ydhfe", "type": "text", "x": 1834, "y": 2793.0, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 565798820, "version": 1, "versionNonce": 623817793, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Loaded: 19 tags, 10,040 links", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Loaded: 19 tags, 10,040 links", "autoResize": false, "lineHeight": 1.25}, {"id": "q6ssriyrzpy74ex50sxx", "type": "text", "x": 1834, "y": 2824.75, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 15316284, "version": 1, "versionNonce": 1115209312, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Chargers with no / one / two tags selected: 2,376 → 752 → 18", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Chargers with no / one / two tags selected: 2,376 → 752 → 18", "autoResize": false, "lineHeight": 1.25}, {"id": "srejbnwj80l3zouzv09f", "type": "text", "x": 1834, "y": 2856.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 158926208, "version": 1, "versionNonce": 2062784780, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Extra index (tag_id, point_id): rare tag found in 0.1 ms instead of 5.7 ms", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Extra index (tag_id, point_id): rare tag found in 0.1 ms instead of 5.7 ms", "autoResize": false, "lineHeight": 1.25}, {"id": "a0ukpx7fsspg76n98uud", "type": "text", "x": 1834, "y": 2888.25, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 438910534, "version": 1, "versionNonce": 1370053284, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Rejected: text column, text[] array, key/value table, one junction per kind\n  (D3)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Rejected: text column, text[] array, key/value table, one junction per kind\n  (D3)", "autoResize": false, "lineHeight": 1.25}, {"id": "0bm186u6975ac8yhmahv", "type": "text", "x": 1834, "y": 2959.75, "width": 143.20000000000002, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 578714646, "version": 1, "versionNonce": 1987484279, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Where to look", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where to look", "autoResize": false, "lineHeight": 1.25}, {"id": "ju6lf1qjmq43k991vt9j", "type": "text", "x": 1834, "y": 2992.75, "width": 466.71999999999997, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 750612993, "version": 1, "versionNonce": 1192761965, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "docs/schema-v2/design-decisions.md  D3\ndocs/schema-v2/explain/03-tag-junction-index.md", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "docs/schema-v2/design-decisions.md  D3\ndocs/schema-v2/explain/03-tag-junction-index.md", "autoResize": false, "lineHeight": 1.25}, {"id": "j6iec10w4r1cipx6y2un", "type": "rectangle", "x": 0, "y": 3092.75, "width": 800, "height": 482, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 523676746, "version": 1, "versionNonce": 331626632, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "kg5cgumfr3hhci9fcr1x", "type": "rectangle", "x": 890, "y": 3092.75, "width": 1750, "height": 482, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 877751413, "version": 1, "versionNonce": 967018693, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "4n4fzhediyxwtmnrexua", "type": "arrow", "x": 808, "y": 3333.75, "width": 74, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 530200225, "version": 1, "versionNonce": 1934845058, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [74, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "1e6io8ye9i1p54184eie", "type": "text", "x": 808, "y": 3301.75, "width": 74, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 149315289, "version": 1, "versionNonce": 208457497, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "proof", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "proof", "autoResize": false, "lineHeight": 1.25}, {"id": "k2hiyiwv5v5k304pm3vb", "type": "rectangle", "x": 24, "y": 3116.75, "width": 46, "height": 46, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#1971c2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 785101400, "version": 1, "versionNonce": 1784682652, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "q0dvxdu2pq8e3i5makm8", "type": "text", "x": 24, "y": 3123.75, "width": 46, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1957094876, "version": 1, "versionNonce": 1021178040, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3", "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "3", "autoResize": false, "lineHeight": 1.25}, {"id": "4goj1r9dmyvhjx8a0qrw", "type": "text", "x": 86, "y": 3122.75, "width": 590.4, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 975173466, "version": 1, "versionNonce": 1855257804, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Each fact is stored once (1NF, 2NF, 3NF)", "fontSize": 28, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Each fact is stored once (1NF, 2NF, 3NF)", "autoResize": false, "lineHeight": 1.25}, {"id": "7spdnlrbqioma6prv2bo", "type": "text", "x": 24, "y": 3176.75, "width": 752, "height": 131.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 635945486, "version": 1, "versionNonce": 35203281, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Normalization means organising tables so nothing is written twice.\nIt has three steps: 1NF, 2NF and 3NF. Example: a tree's German name\nand genus follow from its botanical name, so they sit in a species\ntable of 916 rows and not on 962,000 tree rows. Two exceptions are\ndeliberate and argued.", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Normalization means organising tables so nothing is written twice.\nIt has three steps: 1NF, 2NF and 3NF. Example: a tree's German name\nand genus follow from its botanical name, so they sit in a species\ntable of 916 rows and not on 962,000 tree rows. Two exceptions are\ndeliberate and argued.", "autoResize": false, "lineHeight": 1.25}, {"id": "sgfkra9nfbq78lgqi4m7", "type": "text", "x": 910, "y": 3112.75, "width": 775.38, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330703398, "version": 1, "versionNonce": 1191221856, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "docs/schema-v2/normalization.md: the rule, before, after, how we converted", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "docs/schema-v2/normalization.md: the rule, before, after, how we converted", "autoResize": false, "lineHeight": 1.25}, {"id": "3vo6sh5lvzhw1a5hmawu", "type": "rectangle", "x": 910, "y": 3142.75, "width": 900, "height": 412, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1690412686, "version": 1, "versionNonce": 781041100, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "2ajv0lszacpal4f5wgpg", "type": "text", "x": 926, "y": 3158.75, "width": 808.3199999999999, "height": 380.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2147467929, "version": 1, "versionNonce": 955945123, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1NF  RULE    one value per cell, never a list\n     BEFORE  one text cell:  'Offene-Arbeit/Situationsansatz'   'AC Typ 2; DC CCS'\n     AFTER   one row per value in amenity_point_tag (point_id, tag_id)\n     HOW     the import splits the cell; each value becomes a row in tag\n             and a link row. 19 tags, 10,040 links\n\n2NF  RULE    every column depends on the whole key, not on a part of it\n     BEFORE  single-column keys, so no violation yet; v2 adds composite keys\n     AFTER   amenity_point_tag keeps only the link; kita_detail (point_id,\n             kind_code) keeps only capacity; names stay in amenity_points, tag\n     HOW     checked every table with a composite key: no column describes\n             just one half of it\n\n3NF  RULE    a column depends on the key, not on another column\n     BEFORE  botanical name, German name and genus as text on every tree row\n     AFTER   tree_detail.species_id -> tree_species (botanical_name UNIQUE,\n             german_name, genus); operator_id -> operator (official_ref UNIQUE)\n     HOW     the import upserts the lookup row first (ON CONFLICT\n             (botanical_name)), then stores only its id on the tree", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1NF  RULE    one value per cell, never a list\n     BEFORE  one text cell:  'Offene-Arbeit/Situationsansatz'   'AC Typ 2; DC CCS'\n     AFTER   one row per value in amenity_point_tag (point_id, tag_id)\n     HOW     the import splits the cell; each value becomes a row in tag\n             and a link row. 19 tags, 10,040 links\n\n2NF  RULE    every column depends on the whole key, not on a part of it\n     BEFORE  single-column keys, so no violation yet; v2 adds composite keys\n     AFTER   amenity_point_tag keeps only the link; kita_detail (point_id,\n             kind_code) keeps only capacity; names stay in amenity_points, tag\n     HOW     checked every table with a composite key: no column describes\n             just one half of it\n\n3NF  RULE    a column depends on the key, not on another column\n     BEFORE  botanical name, German name and genus as text on every tree row\n     AFTER   tree_detail.species_id -> tree_species (botanical_name UNIQUE,\n             german_name, genus); operator_id -> operator (official_ref UNIQUE)\n     HOW     the import upserts the lookup row first (ON CONFLICT\n             (botanical_name)), then stores only its id on the tree", "autoResize": false, "lineHeight": 1.25}, {"id": "s95ggbkxkkfs54mn32x2", "type": "text", "x": 1834, "y": 3112.75, "width": 184.8, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1713720499, "version": 1, "versionNonce": 1327100588, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Measured / tested", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Measured / tested", "autoResize": false, "lineHeight": 1.25}, {"id": "o9m4my5uvnvjp8ubdq9e", "type": "text", "x": 1834, "y": 3145.75, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1581322171, "version": 1, "versionNonce": 29401664, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• art_bot → art_dtsch, gattung: 0 conflicts in about 962,000 source trees", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• art_bot → art_dtsch, gattung: 0 conflicts in about 962,000 source trees", "autoResize": false, "lineHeight": 1.25}, {"id": "s23fywu5l7d394b3pdko", "type": "text", "x": 1834, "y": 3177.5, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1250900825, "version": 1, "versionNonce": 1684808820, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• t_nr → t_name, t_art: 0 conflicts over 1,165 Kita operators", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• t_nr → t_name, t_art: 0 conflicts over 1,165 Kita operators", "autoResize": false, "lineHeight": 1.25}, {"id": "jv2wgr8fnywzq093axcn", "type": "text", "x": 1834, "y": 3209.25, "width": 782, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2056635497, "version": 1, "versionNonce": 1409247876, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Stored once: 916 species, 1,404 operators", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Stored once: 916 species, 1,404 operators", "autoResize": false, "lineHeight": 1.25}, {"id": "oejtk49pkkfp58xxeer0", "type": "text", "x": 1834, "y": 3241.0, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 738533186, "version": 1, "versionNonce": 318679460, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Exception 1: district_id is a cached spatial join, re-derived on import\n  (coverage 99.8-100%)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Exception 1: district_id is a cached spatial join, re-derived on import\n  (coverage 99.8-100%)", "autoResize": false, "lineHeight": 1.25}, {"id": "gdf86wg3i6f9tndoiw73", "type": "text", "x": 1834, "y": 3296.5, "width": 782, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1698872530, "version": 1, "versionNonce": 128784838, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Exception 2: the junction repeats kind_code and category_code, but composite\n  foreign keys check them, so they cannot drift", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Exception 2: the junction repeats kind_code and category_code, but composite\n  foreign keys check them, so they cannot drift", "autoResize": false, "lineHeight": 1.25}, {"id": "ygyx19fx7o4pgua9v18s", "type": "text", "x": 1834, "y": 3368.0, "width": 143.20000000000002, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1207643605, "version": 1, "versionNonce": 338587888, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Where to look", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where to look", "autoResize": false, "lineHeight": 1.25}, {"id": "cw1cs4guurd5l07tdqm1", "type": "text", "x": 1834, "y": 3401.0, "width": 496.0, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2130130598, "version": 1, "versionNonce": 595516262, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "docs/schema-v2/normalization.md\ndocs/schema-v2/design-decisions.md  D5, D6, D7, D9\ndocs/schema-v2/erd.md", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "