: 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1808327469, "version": 1, "versionNonce": 766086321, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Backups live on the same laptop as the database; a real setup copies them elsewhere\n• Base backups and pruning are run by hand, not on a schedule\n• Materialized views refresh after each import, so they can be stale in between\n• Near-duplicate connector spellings are stored as published, not merged\n• Distances are straight lines, not walking routes\n• The app only reads data: no editing, no user accounts", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Backups live on the same laptop as the database; a real setup copies them elsewhere\n• Base backups and pruning are run by hand, not on a schedule\n• Materialized views refresh after each import, so they can be stale in between\n• Near-duplicate connector spellings are stored as published, not merged\n• Distances are straight lines, not walking routes\n• The app only reads data: no editing, no user accounts", "autoResize": false, "lineHeight": 1.25}, {"id": "od5k5hf669w9ipsfp74r", "type": "rectangle", "x": 1340.0, "y": 7434.25, "width": 1300.0, "height": 284, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1551760733, "version": 1, "versionNonce": 426191671, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "gxb1dm3sri0skvzxryum", "type": "text", "x": 1362.0, "y": 7450.25, "width": 400.08000000000004, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1189490865, "version": 1, "versionNonce": 511759973, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "To do before hand-in (author)", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "To do before hand-in (author)", "autoResize": false, "lineHeight": 1.25}, {"id": "ckw6q3qgfxvix2voeq6y", "type": "text", "x": 1362.0, "y": 7496.25, "width": 685.0400000000001, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1766575522, "version": 1, "versionNonce": 1493756452, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Give the lecturer read access to the GitHub repository\n• Submit the hand-in form on the Learning Platform\n• Push the branch and merge it to main through a pull request\n• Rehearse the 20-minute demo (script in docs/project-plan.md)", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Give the lecturer read access to the GitHub repository\n• Submit the hand-in form on the Learning Platform\n• Push the branch and merge it to main through a pull request\n• Rehearse the 20-minute demo (script in docs/project-plan.md)", "autoResize": false, "lineHeight": 1.25}, {"id": "kesqkhvyv3f04b9xvtjy", "type": "text", "x": 0, "y": 7758.25, "width": 1188.96, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1861283078, "version": 1, "versionNonce": 600505623, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Sources: README.md, docs/study.md, docs/implementation-log.md, docs/project-plan.md, docs/operations.md, docs/schema-v2/*", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Sources: README.md, docs/study.md, docs/implementation-log.md, docs/project-plan.md, docs/operations.md, docs/schema-v2/*", "autoResize": false, "lineHeight": 1.25}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}