{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-v2",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql+psycopg://postgis:postgis@localhost:5433/berlin",
        "DATABASE_URL_RO=postgresql+psycopg://berlin_ro:berlin_ro@localhost:5433/berlin",
        "backend/.venv/bin/python", "-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
